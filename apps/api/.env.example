DATABASE_URL=postgresql://user:password@localhost:5432/svet_clinic_db?connect_timeout=30
FRONTEND_URL=http://localhost:4200
PORT=3000

# ---------------------------------------------------------------- auth ----
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OAUTH_STATE_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=svet-api

# This API's public origin including the /v1 prefix. Must match the redirect
# URI registered with each identity provider byte for byte.
PUBLIC_API_URL=http://localhost:3000/v1

# The role given to an account that signs itself up. Must match an existing
# row in `role` (this workspace seeds ADMIN, FRONT-DESK, VET). Matched
# case-insensitively.
AUTH_DEFAULT_ROLE=FRONT-DESK

# Google OAuth. Authorised redirect URI to register in the Google Cloud console:
#   http://localhost:3000/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
