# ----------------------------------- database -----------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svet

# ----------------------------------- auth -----------------------------------
# Required. The API refuses to start without them, by design — it will not
# serve traffic it cannot sign or verify tokens for. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional, with the defaults shown.
# JWT_ISSUER=svet-api
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d
# OAUTH_STATE_SECRET=       # derived from JWT_REFRESH_SECRET when unset
# OAUTH_STATE_TTL=10m
# AUTH_DEFAULT_ROLE=FRONT-DESK

# ----------------------------------- google -----------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----------------------------------- urls -----------------------------------
PUBLIC_API_URL=http://localhost:3000/v1
FRONTEND_URL=http://localhost:4200
# for frontend builds
VITE_API_URL=http://localhost:3000/v1

# ----------------------------------- cron -----------------------------------
# Shared secret for the scheduled routes under `/v1/cron/*`. Vercel Cron sends
# it as `Authorization: Bearer <value>`. Unset means those routes refuse every
# caller, so set it on any deployed environment.
CRON_SECRET=



